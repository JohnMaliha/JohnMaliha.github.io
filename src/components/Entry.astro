---
interface Props {
  title: string;
  subtitle?: string;
  date: string;
  description?: string;
  bullets?: string[];
  tech?: string[];
  href?: string;
  site?: string;
}

const { title, subtitle, date, description, bullets, tech, href, site } = Astro.props;
---

<article class={`entry${href || site ? " has-link" : ""}`}>
  <div class="entry-row">
    <h3>
      {title}
      {subtitle && <span class="subtitle"> — {subtitle}</span>}
    </h3>
    <div class="entry-meta">
      <span class="date">{date}</span>
      {
        site && (
          <a
            class="entry-link entry-link--site"
            href={site}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${title} website`}
            title="Visit website"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <polyline points="15 3 21 3 21 9" />
              <line x1="10" y1="14" x2="21" y2="3" />
            </svg>
          </a>
        )
      }
      {
        href && (
          <a
            class="entry-link entry-link--github"
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${title} on GitHub`}
            title="View on GitHub"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 .5C5.73.5.5 5.73.5 12c0 5.09 3.29 9.4 7.86 10.93.58.1.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.27 3.38.97.1-.75.4-1.27.73-1.56-2.55-.29-5.23-1.28-5.23-5.68 0-1.25.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.06 11.06 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.59.24 2.76.12 3.05.74.81 1.18 1.84 1.18 3.09 0 4.41-2.69 5.39-5.25 5.67.41.36.78 1.07.78 2.16 0 1.56-.02 2.81-.02 3.19 0 .31.21.67.8.56C20.71 21.4 24 17.09 24 12 24 5.73 18.27.5 12 .5z" />
            </svg>
          </a>
        )
      }
    </div>
  </div>
  {description && <p class="description">{description}</p>}
  {
    bullets && bullets.length > 0 && (
      <ul class="bullets">
        {bullets.map((b) => (
          <li>{b}</li>
        ))}
      </ul>
    )
  }
  {
    tech && tech.length > 0 && (
      <ul class="tech-tags">
        {tech.map((t) => (
          <li>{t}</li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .entry {
    padding: var(--space-3);
    border: 1px solid var(--line);
    border-left: 3px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .entry + .entry {
    margin-top: var(--space-2);
  }

  .entry.has-link:hover {
    border-left-color: var(--gold);
    background: rgba(216, 178, 106, 0.05);
  }

  .entry-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .subtitle {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: var(--fs-small);
    color: var(--muted);
  }

  .entry-meta {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-shrink: 0;
  }

  .date {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--muted);
    white-space: nowrap;
  }

  .entry-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.6rem;
    height: 1.6rem;
    flex-shrink: 0;
    border-radius: 999px;
    color: var(--muted);
    transition: color 0.15s ease, background 0.15s ease;
  }

  .entry-link svg {
    width: 1rem;
    height: 1rem;
  }

  .entry-link--github svg {
    fill: currentColor;
  }

  .entry-link--site svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .entry-link:hover {
    color: var(--gold);
    background: var(--gold-dim);
  }

  .description {
    color: var(--muted);
    font-size: var(--fs-small);
    margin-top: 0.35rem;
  }

  .tech-tags {
    list-style: none;
    margin: 0.6rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tech-tags li {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--panel);
  }

  .bullets {
    margin: 0.6rem 0 0;
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .bullets li {
    font-size: var(--fs-small);
    color: var(--text);
  }
</style>
