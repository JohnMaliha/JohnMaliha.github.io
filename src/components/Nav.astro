---
import { profile } from "../data/cv";

const links = [
  { href: "/#profile", label: "Profile" },
  { href: "/#what-i-build", label: "Build" },
  { href: "/#experience", label: "Experience" },
  { href: "/#projects", label: "Projects" },
  { href: "/#snake", label: "Play" },
  { href: "/#skills", label: "Skills" },
  { href: "/#education", label: "Education" },
  { href: "/#contact", label: "Contact" },
  { href: profile.resumeHref, label: "Résumé", external: true },
];
---

<header class="nav" id="site-nav">
  <span class="nav-progress" id="nav-progress"></span>
  <div class="wrap nav-inner">
    <a class="nav-mark" href="/#top" aria-label="Back to top">JM</a>
    <nav class="nav-links" aria-label="Site navigation">
      {
        links.map((l) => (
          <a
            href={l.href}
            data-nav-link
            target={l.external ? "_blank" : undefined}
            rel={l.external ? "noopener noreferrer" : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const navLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]"),
  );

  function hashId(href: string): string | null {
    const i = href.indexOf("#");
    return i === -1 ? null : href.slice(i + 1);
  }

  const sections = navLinks
    .map((l) => {
      const id = hashId(l.getAttribute("href") || "");
      return id ? document.getElementById(id) : null;
    })
    .filter((el): el is HTMLElement => el instanceof HTMLElement);

  function setActive(id: string) {
    for (const l of navLinks) {
      l.classList.toggle(
        "is-active",
        hashId(l.getAttribute("href") || "") === id,
      );
    }
  }

  let suppressUntil = 0;

  const observer = new IntersectionObserver(
    (entries) => {
      if (Date.now() < suppressUntil) return;
      const visible = entries
        .filter((e) => e.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (visible) setActive(visible.target.id);
    },
    { rootMargin: "-35% 0px -55% 0px", threshold: [0, 0.25, 0.5, 0.75, 1] },
  );
  sections.forEach((s) => observer.observe(s));

  for (const l of navLinks) {
    const id = hashId(l.getAttribute("href") || "");
    if (!id) continue;
    l.addEventListener("click", () => {
      suppressUntil = Date.now() + 900;
      setActive(id);
    });
  }

  const lastSection = sections[sections.length - 1];

  const progress = document.getElementById("nav-progress");
  function onScroll() {
    const doc = document.documentElement;
    const max = doc.scrollHeight - doc.clientHeight;
    const ratio = max > 0 ? doc.scrollTop / max : 0;
    if (progress) {
      progress.style.transform = `scaleX(${Math.min(1, Math.max(0, ratio))})`;
    }
    if (lastSection && ratio > 0.995) {
      setActive(lastSection.id);
    }
  }
  document.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    height: var(--nav-h);
    z-index: 40;
    background: rgba(12, 17, 29, 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .nav-progress {
    position: absolute;
    inset: auto 0 0 0;
    height: 2px;
    background: linear-gradient(90deg, var(--cyan) 0%, var(--gold) 100%);
    opacity: 0.75;
    transform: scaleX(0);
    transform-origin: left;
    will-change: transform;
  }

  .nav-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .nav-mark {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    flex-shrink: 0;
  }

  .nav-mark:hover {
    color: var(--gold);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.3rem;
    overflow-x: auto;
    scrollbar-width: none;
    white-space: nowrap;
    padding: 0 4px;
    mask-image: linear-gradient(to right, transparent 0, black 12px, black calc(100% - 12px), transparent 100%);
  }

  .nav-links::-webkit-scrollbar {
    display: none;
  }

  .nav-links a {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
    text-decoration: none;
    padding: 0.25rem 0.1rem;
  }

  .nav-links a:hover {
    color: var(--text);
  }

  .nav-links a.is-active {
    color: var(--gold);
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-underline-offset: 5px;
  }
</style>
