---
import { contactLinks } from "../data/cv";

interface Props {
  variant?: "inline" | "buttons";
}

const { variant = "inline" } = Astro.props;

const ICON_PATHS: Record<string, string> = {
  github:
    "M12 .5C5.73.5.5 5.73.5 12c0 5.09 3.29 9.4 7.86 10.93.58.1.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.27 3.38.97.1-.75.4-1.27.73-1.56-2.55-.29-5.23-1.28-5.23-5.68 0-1.25.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.06 11.06 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.59.24 2.76.12 3.05.74.81 1.18 1.84 1.18 3.09 0 4.41-2.69 5.39-5.25 5.67.41.36.78 1.07.78 2.16 0 1.56-.02 2.81-.02 3.19 0 .31.21.67.8.56C20.71 21.4 24 17.09 24 12 24 5.73 18.27.5 12 .5z",
  linkedin:
    "M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z",
  email:
    "M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z",
};

const TONE: Record<string, string> = {
  email: "magenta",
  github: "gold",
  linkedin: "cyan",
};
---

<ul class={`social-list social-list--${variant}`}>
  {
    contactLinks.map((link) => (
      <li>
        <a
          href={link.href}
          class={`social-link tone-${TONE[link.icon]}`}
          aria-label={link.label}
          title={link.label}
          target={link.icon === "email" ? undefined : "_blank"}
          rel={link.icon === "email" ? undefined : "noopener noreferrer"}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d={ICON_PATHS[link.icon]} />
          </svg>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
  }

  .social-link svg {
    width: 1em;
    height: 1em;
    fill: currentColor;
  }

  /* inline: small, used in the footer */
  .social-list--inline .social-link {
    font-size: 1.15rem;
  }

  .social-list--inline .social-link.tone-gold:hover {
    color: var(--gold);
  }

  .social-list--inline .social-link.tone-cyan:hover {
    color: var(--cyan);
  }

  .social-list--inline .social-link.tone-magenta:hover {
    color: var(--magenta);
  }

  /* buttons: larger circular targets, used on the contact page */
  .social-list--buttons {
    gap: 0.9rem;
  }

  .social-list--buttons .social-link {
    width: 3.25rem;
    height: 3.25rem;
    font-size: 1.4rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .social-list--buttons .social-link:hover {
    transform: translateY(-2px);
  }

  .social-list--buttons .social-link.tone-gold:hover {
    color: var(--gold);
    border-color: var(--gold);
    background: var(--gold-dim);
  }

  .social-list--buttons .social-link.tone-cyan:hover {
    color: var(--cyan);
    border-color: var(--cyan);
    background: var(--cyan-dim);
  }

  .social-list--buttons .social-link.tone-magenta:hover {
    color: var(--magenta);
    border-color: var(--magenta);
    background: var(--magenta-dim);
  }

  @media (prefers-reduced-motion: reduce) {
    .social-link {
      transition: none;
    }
  }
</style>
